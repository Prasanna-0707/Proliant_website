############################################################
# 8. PASSWORD RESET
############################################################

### 8.1 Forgot Password
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "YOUR_ADMIN_EMAIL"
}

###

### 8.2 Verify Reset OTP
# Enter the OTP received in the password-reset email
POST {{baseUrl}}/auth/verify-reset-otp
Content-Type: application/json

{
  "email": "YOUR_ADMIN_EMAIL",
  "otp": "ENTER_RESET_OTP_HERE"
}

###

### 8.3 Reset Password
# Replace RESET_TOKEN with the token returned by 8.2
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "email": "YOUR_ADMIN_EMAIL",
  "resetToken": "RESET_TOKEN_HERE",
  "newPassword": "NewAdmin@123"
}

###

### 8.4 Change Password
# Use a valid JWT obtained after login + OTP verification
PATCH {{baseUrl}}/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "YOUR_CURRENT_PASSWORD",
  "newPassword": "NewAdmin@123"
}

###

############################################################
# 9. EXCEL EXPORT
############################################################

### 9.1 Export Candidates to Excel - ADMIN
GET {{baseUrl}}/candidates/export/excel
Authorization: Bearer {{token}}

###

############################################################
# 10. TEAM MEMBER APIs
############################################################

### 10.1 GET ALL TEAM MEMBERS
# Expected:
# 200 OK
# Should return the existing admins also.
GET {{baseUrl}}/auth/team-members
Authorization: Bearer {{token}}

###

### 10.2 GET ONE TEAM MEMBER
# First run GET ALL above and copy one _id.
# Replace TEAM_MEMBER_ID below.
GET {{baseUrl}}/auth/team-members/TEAM_MEMBER_ID
Authorization: Bearer {{token}}

###

### 10.3 CREATE TEAM MEMBER
# Temporary password will be generated automatically
# and sent to the provided email.
POST {{baseUrl}}/auth/team-members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "team.member@proliant.com"
}

###

### 10.4 UPDATE TEAM MEMBER
# Replace TEAM_MEMBER_ID with the ID returned by GET/CREATE.
PUT {{baseUrl}}/auth/team-members/TEAM_MEMBER_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "updated.member@proliant.com"
}

###

### 10.5 DELETE TEAM MEMBER
# Replace TEAM_MEMBER_ID with the team member ID.
# Do NOT use the ID of the currently logged-in admin.
# Our API prevents deleting your own account.
DELETE {{baseUrl}}/auth/team-members/TEAM_MEMBER_ID
Authorization: Bearer {{token}}

###

############################################################
# 11. ADMIN PROFILE APIs
############################################################

### 11.1 Get My Admin Profile
# Requires a valid JWT obtained after login + OTP verification
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

###

### 11.2 Update My Admin Profile
# Only name, phone and designation can be updated
PATCH {{baseUrl}}/auth/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Prasanna Kumar",
  "phone": "9876543210",
  "designation": "Administrator"
}

###

### 11.3 Get My Profile After Update
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

###

### 11.4 Try Updating Email
# This should fail because email changes are not allowed
# through the profile API
PATCH {{baseUrl}}/auth/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "newemail@example.com"
}

###

### 11.5 Try Updating Password
# This should fail because password changes must use
# the existing /auth/change-password API
PATCH {{baseUrl}}/auth/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "password": "NewPassword@123"
}

###

