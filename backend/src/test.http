############################################################
# TEAM MEMBER APIs
############################################################

### 1. GET ALL TEAM MEMBERS
# Expected:
# 200 OK
# Should return the existing 2 admins also.

GET {{baseUrl}}/auth/team-members
Authorization: Bearer {{token}}

###

### 2. GET ONE TEAM MEMBER
# First run GET ALL above and copy one _id.
# Replace the ID below.

GET {{baseUrl}}/auth/team-members/6aaccfa85f57661a794abee3
Authorization: Bearer {{token}}

###

### 3. CREATE TEAM MEMBER
# Temporary password will be generated automatically
# and sent to the provided email.

POST {{baseUrl}}/auth/team-members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "team.member@proliant.com"
}

###

### 4. UPDATE TEAM MEMBER
# Replace the ID with the ID returned by CREATE.

PUT {{baseUrl}}/auth/team-members/6aace760283029dff29a88ec
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "updated.member@proliant.com"
}

###

### 5. DELETE TEAM MEMBER
# Replace the ID with the team member ID.
# Do NOT use the ID of the currently logged-in admin.
# Our API prevents deleting your own account.

DELETE {{baseUrl}}/auth/team-members/6aace760283029dff29a88ec
Authorization: Bearer {{token}}

###