############################################################
# 8. PASSWORD RESET
############################################################

### 8.1 Forgot Password
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "bogachandrapu@gmail.com"
}

###

### 8.2 Verify Reset OTP
# Enter the OTP received in the password-reset email
POST {{baseUrl}}/auth/verify-reset-otp
Content-Type: application/json

{
  "email": "bogachandrapu@gmail.com",
  "otp": "ENTER_RESET_OTP_HERE"
}

###

### 8.3 Reset Password
# Replace RESET_TOKEN with the token returned by 8.2
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "email": "bogachandrapu@gmail.com",
  "resetToken": "RESET_TOKEN_HERE",
  "newPassword": "NewAdmin@123"
}

###

### 8.4 Change Password
# Use a valid JWT obtained after login + OTP verification
PATCH {{baseUrl}}/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "NewAdmin@123",
  "newPassword": "Admin@123"
}

###


