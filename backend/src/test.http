############################################################
# 10. TEAM MEMBER APIs
############################################################

### 10.1 GET ALL TEAM MEMBERS
# Expected:
# 200 OK
# Should return the existing admins also.
GET {{baseUrl}}/auth/team-members
Authorization: Bearer {{token}}

###

### 10.2 GET ONE TEAM MEMBER
# First run GET ALL above and copy one _id.
# Replace TEAM_MEMBER_ID below.
GET {{baseUrl}}/auth/team-members/TEAM_MEMBER_ID
Authorization: Bearer {{token}}

###

### 10.3 CREATE TEAM MEMBER
# Temporary password will be generated automatically
# and sent to the provided email.
POST {{baseUrl}}/auth/team-members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "team.member@proliant.com"
}

###

### 10.4 UPDATE TEAM MEMBER
# Replace TEAM_MEMBER_ID with the ID returned by GET/CREATE.
PUT {{baseUrl}}/auth/team-members/TEAM_MEMBER_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "updated.member@proliant.com"
}

###

### 10.5 DELETE TEAM MEMBER
# Replace TEAM_MEMBER_ID with the team member ID.
# Do NOT use the ID of the currently logged-in admin.
# Our API prevents deleting your own account.
DELETE {{baseUrl}}/auth/team-members/TEAM_MEMBER_ID
Authorization: Bearer {{token}}

###


