############################################################
# 8. NEW AUTHENTICATION FLOW TESTING
############################################################

### 8.1 Login - Password Verification

POST {{baseUrl}}/auth/login

Content-Type: application/json

{
  "email": "bogachandrapu@gmail.com",
  "password": "Admin@123"
}

###

### 8.2 Verify Login OTP

# Enter the OTP received in the admin email

POST {{baseUrl}}/auth/verify-login-otp

Content-Type: application/json

{
  "email": "bogachandrapu@gmail.com",
  "otp": "ENTER_LOGIN_OTP_HERE"
}

###

### 8.3 Forgot Password

POST {{baseUrl}}/auth/forgot-password

Content-Type: application/json

{
  "email": "bogachandrapu@gmail.com"
}

###

### 8.4 Verify Reset OTP

# Enter the OTP received in the password-reset email

POST {{baseUrl}}/auth/verify-reset-otp

Content-Type: application/json

{
  "email": "bogachandrapu@gmail.com",
  "otp": "ENTER_RESET_OTP_HERE"
}

###

### 8.5 Reset Password

# Replace RESET_TOKEN with the token returned by 8.4

POST {{baseUrl}}/auth/reset-password

Content-Type: application/json

{
  "email": "bogachandrapu@gmail.com",
  "resetToken": "RESET_TOKEN_HERE",
  "newPassword": "NewAdmin@123"
}

###

### 8.6 Change Password

# Replace TOKEN with a newly generated login JWT

PATCH {{baseUrl}}/auth/change-password

Authorization: Bearer TOKEN

Content-Type: application/json

{
  "currentPassword": "NewAdmin@123",
  "newPassword": "AnotherAdmin@123"
}

###

