############################################################
# 3. EMPLOYEES
############################################################

### 3.1 Get All Employees - ADMIN
GET {{baseUrl}}/employees
Authorization: Bearer {{token}}

###

### 3.2 Add Employee - ADMIN
POST {{baseUrl}}/employees
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rahul Kumar",
  "email": "rahul.test@proliant.com",
  "role": "SAP MM Consultant",
  "department": "SAP",
  "status": "Active"
}

###

### 3.3 Update Employee - ADMIN
# Replace EMPLOYEE_ID with an actual employee _id
PUT {{baseUrl}}/employees/EMPLOYEE_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rahul Kumar",
  "email": "rahul.updated@proliant.com",
  "role": "SAP MM Consultant",
  "department": "SAP",
  "status": "Active"
}

###

### 3.4 Delete Employee - ADMIN
# Replace EMPLOYEE_ID with an actual employee _id
DELETE {{baseUrl}}/employees/EMPLOYEE_ID
Authorization: Bearer {{token}}

###


