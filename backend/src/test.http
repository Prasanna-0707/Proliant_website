@baseUrl = http://localhost:5000/api

# Update these after successful OTP verification
@token = PASTE_ADMIN_TOKEN_HERE

@CandidateToken = PASTE_CANDIDATE_TOKEN_HERE

@applicationId = 6ad9b0052a4f49f5ed6ca264

@interviewId = PASTE_REAL_INTERVIEW_ID_HERE
@stageCode = L1

# Use a different application ID for HR review testing
@hrReviewApplicationId = REPLACE_WITH_ANOTHER_APPLICATION_ID
@candidateId = REPLACE_WITH_ACTUAL_CANDIDATE_ID
############################################################
# 1. AUTHENTICATION — LOGIN + OTP
############################################################

### 1.1 Login - Password Verification + Send Login OTP
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "YOUR_ADMIN_EMAIL",
  "password": "YOUR_ADMIN_PASSWORD"
}

###

### 1.2 Verify Login OTP
# Enter the OTP received in the admin email
POST {{baseUrl}}/auth/verify-login-otp
Content-Type: application/json

{
  "email": "YOUR_ADMIN_EMAIL",
  "otp": "ENTER_LOGIN_OTP_HERE"
}

###

### 1.3 Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}

###

############################################################
# 2. DASHBOARD
############################################################

### 2.1 Get Dashboard Stats - ADMIN
GET {{baseUrl}}/dashboard/stats
Authorization: Bearer {{token}}

###

### 2.2 Get Dashboard Stats - NO TOKEN
# Expected: 401 Unauthorized
GET {{baseUrl}}/dashboard/stats

###

############################################################
# 3. EMPLOYEES
############################################################

### 3.1 Get All Employees - ADMIN
GET {{baseUrl}}/employees
Authorization: Bearer {{token}}

###

### 3.2 Add Employee - ADMIN
POST {{baseUrl}}/employees
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rahul Kumar",
  "email": "rahul.test@proliant.com",
  "role": "SAP MM Consultant",
  "department": "SAP",
  "status": "Active"
}

###

### 3.3 Update Employee - ADMIN
# Replace EMPLOYEE_ID with an actual employee _id
PUT {{baseUrl}}/employees/EMPLOYEE_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Rahul Kumar",
  "email": "rahul.updated@proliant.com",
  "role": "SAP MM Consultant",
  "department": "SAP",
  "status": "Active"
}

###

### 3.4 Delete Employee - ADMIN
# Replace EMPLOYEE_ID with an actual employee _id
DELETE {{baseUrl}}/employees/EMPLOYEE_ID
Authorization: Bearer {{token}}

###

