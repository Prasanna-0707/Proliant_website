############################################################
# ADDED: REQUESTS FOR PREVIOUSLY UNCOVERED APIs
# Replace the placeholder values before sending.
############################################################

@userId = REPLACE_WITH_ADMIN_USER_ID
@roleId = REPLACE_WITH_ROLE_ID
@hiringApplicationId = REPLACE_WITH_APPLICATION_ID
@hiringToken = PASTE_HIRING_MANAGER_TOKEN_HERE

############################################################
# A. ADMINISTRATOR APIs  (/api/admin)
# Existing coverage: GET /admin/users, GET /admin/dashboard
############################################################

### A.1 Administrator - Get Users With Filters
GET {{baseUrl}}/admin/users?page=1&limit=20&status=Active&search=admin&sortBy=createdAt&sortOrder=desc
Authorization: Bearer {{token}}

###

### A.2 Administrator - Get User By ID
GET {{baseUrl}}/admin/users/{{userId}}
Authorization: Bearer {{token}}

###

### A.3 Administrator - Create User
POST {{baseUrl}}/admin/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "new.user@proliant.com",
  "name": "New User",
  "phone": "9876543210",
  "role": "HR",
  "department": "Human Resources"
}

###

### A.4 Administrator - Update User
# role / roles / adminScope are rejected here. Use A.5 for those.
PATCH {{baseUrl}}/admin/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Name",
  "phone": "9876543210",
  "department": "Engineering"
}

###

### A.5 Administrator - Update User Role
# Allowed fields: role, adminScope, department, reason
PATCH {{baseUrl}}/admin/users/{{userId}}/role
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "L0_SCREENER",
  "reason": "Assigned to the screening team."
}

###

### A.6 Administrator - Update User Role (department admin scope)
PATCH {{baseUrl}}/admin/users/{{userId}}/role
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "Administrator",
  "adminScope": "DEPARTMENT",
  "department": "Engineering",
  "reason": "Promote to department administrator."
}

###

### A.7 Administrator - Get Roles
GET {{baseUrl}}/admin/roles
Authorization: Bearer {{token}}

###

### A.8 Administrator - Get Roles Including Inactive
GET {{baseUrl}}/admin/roles?includeInactive=true
Authorization: Bearer {{token}}

###

### A.9 Administrator - Update Role Permissions
# Maximum 100 permissions. Each must exist in the permission catalog.
PUT {{baseUrl}}/admin/roles/{{roleId}}/permissions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "permissions": [
    "applications.read",
    "applications.resume.read",
    "screening.history.read",
    "team.members.read"
  ],
  "reason": "Align HR role with current responsibilities."
}

###

### A.10 Administrator - Get Audit Logs
GET {{baseUrl}}/admin/audit-logs
Authorization: Bearer {{token}}

###

### A.11 Administrator - Get Settings
GET {{baseUrl}}/admin/settings
Authorization: Bearer {{token}}

###

### A.12 Administrator - Get Settings By Category
# Categories: GENERAL, SECURITY, NOTIFICATIONS, RECRUITMENT
GET {{baseUrl}}/admin/settings?category=GENERAL&search=company
Authorization: Bearer {{token}}

###

### A.13 Administrator - Update Setting
# Keys must match [a-z0-9._-]+. Secrets, tokens and passwords are rejected.
PATCH {{baseUrl}}/admin/settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "general.company.name",
  "value": "Proliant Data",
  "category": "GENERAL",
  "description": "Company display name",
  "reason": "Initial configuration"
}

###

### A.14 Administrator - Update Setting With Sensitive Key (expected 400)
PATCH {{baseUrl}}/admin/settings
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "smtp.password",
  "value": "should-be-rejected",
  "category": "SECURITY"
}

###

############################################################
# B. HIRING MANAGER APIs  (/api/hiring, /api/applications)
# Login as a HIRING_MANAGER / HIRING_LEAD account and use its token.
############################################################

### B.1 Hiring Manager - Pipeline
GET {{baseUrl}}/hiring/pipeline
Authorization: Bearer {{hiringToken}}

###

### B.2 Hiring Manager - Feedback History
GET {{baseUrl}}/hiring/feedback-history
Authorization: Bearer {{hiringToken}}

###

### B.3 Hiring Manager - Application Details
GET {{baseUrl}}/applications/{{hiringApplicationId}}
Authorization: Bearer {{hiringToken}}

###

### B.4 Hiring Manager - Application Feedback
GET {{baseUrl}}/applications/{{hiringApplicationId}}/feedback
Authorization: Bearer {{hiringToken}}

###

### B.5 Hiring Manager - Get Decisions
GET {{baseUrl}}/applications/{{hiringApplicationId}}/decisions
Authorization: Bearer {{hiringToken}}

###

### B.6 Hiring Manager - Advance Candidate
# decision: Advance | Reject | Hold
# reason is required for Reject and Hold (max 3000 characters).
POST {{baseUrl}}/applications/{{hiringApplicationId}}/decisions
Authorization: Bearer {{hiringToken}}
Content-Type: application/json

{
  "stageCode": "L1",
  "decision": "Advance",
  "reason": "Strong technical evaluation."
}

###

### B.7 Hiring Manager - Reject Candidate
POST {{baseUrl}}/applications/{{hiringApplicationId}}/decisions
Authorization: Bearer {{hiringToken}}
Content-Type: application/json

{
  "stageCode": "L1",
  "decision": "Reject",
  "reason": "Did not meet the required technical depth."
}

###

### B.8 Hiring Manager - Hold Candidate
POST {{baseUrl}}/applications/{{hiringApplicationId}}/decisions
Authorization: Bearer {{hiringToken}}
Content-Type: application/json

{
  "stageCode": "L1",
  "decision": "Hold",
  "reason": "Waiting for budget approval."
}

###

### B.9 Hiring Manager - Reject Without Reason (expected 400)
POST {{baseUrl}}/applications/{{hiringApplicationId}}/decisions
Authorization: Bearer {{hiringToken}}
Content-Type: application/json

{
  "stageCode": "L1",
  "decision": "Reject"
}

###

### B.10 Hiring Manager - Invalid Decision Value (expected 400)
POST {{baseUrl}}/applications/{{hiringApplicationId}}/decisions
Authorization: Bearer {{hiringToken}}
Content-Type: application/json

{
  "stageCode": "L1",
  "decision": "Maybe",
  "reason": "Invalid decision value test."
}

###

