{
  "companyName": "Proliant Data India Updated",
  "phone": "+91 9111111111"
}

###

### 4.4 Delete Location - ADMIN
# Replace LOCATION_ID with actual location _id
DELETE {{baseUrl}}/locations/LOCATION_ID
