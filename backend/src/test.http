Authorization: Bearer {{token}}

###

###############################  Get application details###############################
GET {{baseUrl}}/applications/{{applicationId}}
Authorization: Bearer {{token}}

###

### 3. Download application resume
GET {{baseUrl}}/applications/{{applicationId}}/resume
Authorization: Bearer {{token}}

###

### 4. Start L0 screening
PATCH {{baseUrl}}/applications/{{applicationId}}/start
Authorization: Bearer {{token}}

Screening Checklist APIs
### 5. Get screening checklist
GET {{baseUrl}}/applications/{{applicationId}}/checklist
Authorization: Bearer {{token}}

###

### 6. Update screening checklist
PUT {{baseUrl}}/applications/{{applicationId}}/checklist
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "checklist": {
    "skillsMatch": true,
    "experienceMatch": true,
    "educationMatch": true,
    "requirementsMatch": true,
    "additionalNotes": "Candidate meets the required technical qualifications."
  }
}

################################Screening Decision API####################################
###Submit SHORTLIST decision##
POST {{baseUrl}}/applications/{{applicationId}}/decision
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "decision": "SHORTLIST",
  "feedback": "Candidate meets the initial screening requirements.",
  "remarks": "Proceed to the next interview stage."
}

