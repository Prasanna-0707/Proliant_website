############################################################
# 5. JOBS
############################################################

### 5.1 Get Published Jobs - PUBLIC
GET {{baseUrl}}/jobs

###

### 5.2 Get Single Published Job - PUBLIC
# Replace JOB_ID with actual published job _id
GET {{baseUrl}}/jobs/JOB_ID

###

### 5.3 Create Job - ADMIN
POST {{baseUrl}}/jobs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "SAP ABAP Developer",
  "department": "SAP",
  "employmentType": "Full Time",
  "experience": "3+ Years",
  "location": "Hyderabad, India",
  "status": "Published",
  "jobDescription": "We are looking for an SAP ABAP Developer to join our team.",
  "requirements": "Experience with ABAP, SAP development and debugging."
}

###

### 5.4 Update Job - ADMIN
# Replace JOB_ID with actual job _id
PUT {{baseUrl}}/jobs/JOB_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Senior SAP ABAP Developer",
  "department": "SAP",
  "employmentType": "Full Time",
  "experience": "5+ Years",
  "location": "Hyderabad, India",
  "status": "Published",
  "jobDescription": "We are looking for a Senior SAP ABAP Developer to join our team.",
  "requirements": "Experience with ABAP, SAP development, debugging and SAP S/4HANA."
}

###

### 5.5 Delete Job - ADMIN
# Replace JOB_ID with actual job _id
DELETE {{baseUrl}}/jobs/JOB_ID
Authorization: Bearer {{token}}

###


############################################################
# 6. CONTACT ENQUIRIES
############################################################

### 6.1 Create Contact Enquiry - PUBLIC
POST {{baseUrl}}/contacts
Content-Type: application/json

{
  "name": "Suresh Kumar",
  "email": "suresh.kumar@gmail.com",
  "company": "ABC Technologies",
  "subject": "SAP Implementation Services",
  "message": "We are looking for SAP implementation support for our organization."
}

###

### 6.2 Get All Contact Enquiries - ADMIN
GET {{baseUrl}}/contacts
Authorization: Bearer {{token}}

###

### 6.3 Get Single Contact Enquiry - ADMIN
# Replace CONTACT_ID with actual contact _id
GET {{baseUrl}}/contacts/CONTACT_ID
Authorization: Bearer {{token}}

###

### 6.4 Update Contact Status - ADMIN
# Replace CONTACT_ID with actual contact _id
PATCH {{baseUrl}}/contacts/CONTACT_ID/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "Read"
}

###

### 6.5 Delete Contact Enquiry - ADMIN
# Replace CONTACT_ID with actual contact _id
DELETE {{baseUrl}}/contacts/CONTACT_ID
Authorization: Bearer {{token}}

###


############################################################
# 7. CANDIDATES
############################################################

### 7.1 Create Candidate Application - PUBLIC
POST {{baseUrl}}/candidates
Content-Type: application/json

{
  "position": "SAP ABAP Developer",
  "areaOfInterest": "SAP ABAP",
  "name": "Ravi Kumar",
  "email": "ravi.kumar.test@gmail.com",
  "phone": "9876543210",
  "isFresher": true,
  "location": "Hyderabad, India",
  "yearsOfExperience": null,
  "highestQualification": "B.Tech",
  "currentCompany": null,
  "noticePeriod": "Immediately",
  "coverMessage": "I am interested in this position.",
  "resume": null
}

###

### 7.2 Get All Candidates - ADMIN
GET {{baseUrl}}/candidates
Authorization: Bearer {{token}}

###

### 7.3 Get Single Candidate - ADMIN
# Replace CANDIDATE_ID with actual candidate _id
GET {{baseUrl}}/candidates/CANDIDATE_ID
Authorization: Bearer {{token}}

###

### 7.4 Update Candidate - ADMIN
# Replace CANDIDATE_ID with actual candidate _id
PUT {{baseUrl}}/candidates/CANDIDATE_ID
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "Shortlisted"
}

###

### 7.5 Delete Candidate - ADMIN
# Replace CANDIDATE_ID with actual candidate _id
DELETE {{baseUrl}}/candidates/CANDIDATE_ID
Authorization: Bearer {{token}}

