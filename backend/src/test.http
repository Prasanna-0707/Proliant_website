############################################################
# REGISTRATION-BASED CANDIDATE WORKFLOW  (/api/candidates)
# Model Candidate, collection candidates. Separate from the HR portal
# records above (/api/hr-candidates, model HRCandidate, collection hrcandidates).
############################################################

### R.1 Candidate registers / applies for a published job - PUBLIC
# jobId must be a published job. The job's department is copied onto the
# record and an L0 screener from that department is assigned automatically.
POST {{baseUrl}}/candidates
Content-Type: application/json

{
  "jobId": "PASTE_PUBLISHED_JOB_ID",
  "areaOfInterest": "SAP",
  "name": "Registration Candidate",
  "email": "registration.candidate@example.com",
  "phone": "9876543210",
  "isFresher": false,
  "yearsOfExperience": 3,
  "highestQualification": "B.Tech",
  "noticePeriod": "30 Days"
}

###

### R.2 List registered candidates - HR / Global Administrator
GET {{baseUrl}}/candidates
Authorization: Bearer {{token}}

###

### R.3 Registered candidate by id - HR / Global Administrator
GET {{baseUrl}}/candidates/{{candidateId}}
Authorization: Bearer {{token}}

###############################################################
# NEW WORKFLOW APIs (interviews, assignments, screeners,
# notifications, public stats, candidate password reset)
# Placeholders: @token = staff token, @CandidateToken = candidate token
###############################################################

@newInterviewId = PASTE_INTERVIEW_ID
@assignmentId = PASTE_ASSIGNMENT_ID
@jobId = PASTE_JOB_ID
@screenerId = PASTE_SCREENER_USER_ID
@interviewerId = PASTE_INTERVIEWER_USER_ID
@hiringManagerId = PASTE_HIRING_MANAGER_USER_ID
@notificationId = PASTE_NOTIFICATION_ID

### N1 Public statistics (no auth)
GET {{baseUrl}}/public/stats

### N2 Staff notifications
GET {{baseUrl}}/notifications?limit=20
Authorization: Bearer {{token}}

### N3 Unread count
GET {{baseUrl}}/notifications/unread-count
Authorization: Bearer {{token}}

### N4 Mark one notification read
PATCH {{baseUrl}}/notifications/{{notificationId}}/read
Authorization: Bearer {{token}}

### N5 Mark all notifications read
PATCH {{baseUrl}}/notifications/read-all
Authorization: Bearer {{token}}

### N6 Eligible interviewers for a stage (HR / Global Admin / L0 Screener)
GET {{baseUrl}}/interviews/interviewers?stageCode={{stageCode}}
Authorization: Bearer {{token}}

### N7 Schedule an interview (stageCode optional: defaults to the first interview stage)
POST {{baseUrl}}/interviews
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "applicationId": "{{applicationId}}",
  "stageCode": "L1",
  "interviewerId": "{{interviewerId}}",
  "scheduledAt": "2030-01-15T10:00:00.000Z",
  "timeZone": "Asia/Kolkata",
  "durationMinutes": 45,
  "mode": "Online",
  "meetingLink": "https://meet.example.com/abc",
  "instructions": "Bring a photo ID"
}

### N8 List interviews (filters: status, stageCode, applicationId, interviewerId, jobId, from, to)
GET {{baseUrl}}/interviews?status=Scheduled,Rescheduled&stageCode=L1
Authorization: Bearer {{token}}

### N9 Interview detail with scheduling history
GET {{baseUrl}}/interviews/manage/{{newInterviewId}}
Authorization: Bearer {{token}}

### N10 Reschedule (reason required)
PATCH {{baseUrl}}/interviews/{{newInterviewId}}/reschedule
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "scheduledAt": "2030-01-16T10:00:00.000Z",
  "timeZone": "Asia/Kolkata",
  "reason": "Interviewer unavailable"
}

### N11 Reassign interviewer
PATCH {{baseUrl}}/interviews/{{newInterviewId}}/assign
Authorization: Bearer {{token}}
Content-Type: application/json

{ "interviewerId": "{{interviewerId}}", "reason": "Specialist needed" }

### N12 Cancel (reason required)
PATCH {{baseUrl}}/interviews/{{newInterviewId}}/cancel
Authorization: Bearer {{token}}
Content-Type: application/json

{ "reason": "Role on hold" }

### N13 Hiring Manager: scheduled interviews for assigned jobs
GET {{baseUrl}}/hiring/interviews
Authorization: Bearer {{token}}

### N14 Hiring Manager assignments (HR / Global Admin)
GET {{baseUrl}}/hiring/assignments?status=Active
Authorization: Bearer {{token}}

### N15 Hiring Manager picker
GET {{baseUrl}}/hiring/assignments/managers
Authorization: Bearer {{token}}

### N16 Assign a Hiring Manager to a job
POST {{baseUrl}}/hiring/assignments
Authorization: Bearer {{token}}
Content-Type: application/json

{ "jobId": "{{jobId}}", "hiringManagerId": "{{hiringManagerId}}" }

### N17 Reassign
PATCH {{baseUrl}}/hiring/assignments/{{assignmentId}}/reassign
Authorization: Bearer {{token}}
Content-Type: application/json

{ "hiringManagerId": "{{hiringManagerId}}", "reason": "Cover" }

### N18 Revoke
DELETE {{baseUrl}}/hiring/assignments/{{assignmentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "reason": "No longer needed" }

### N19 Hiring decision: Advance | Reject | Hold | Select (Select only at the final stage)
POST {{baseUrl}}/applications/{{applicationId}}/decisions
Authorization: Bearer {{token}}
Content-Type: application/json

{ "stageCode": "L1", "decision": "Advance", "reason": "Strong evaluation" }

### N20 HR: L0 screeners with workload
GET {{baseUrl}}/hr-screeners
Authorization: Bearer {{token}}

### N21 HR: applications for assignment (scope: unassigned | assigned | all)
GET {{baseUrl}}/hr-screeners/applications?scope=unassigned
Authorization: Bearer {{token}}

### N22 HR: assign a screener
POST {{baseUrl}}/hr-screeners/assign
Authorization: Bearer {{token}}
Content-Type: application/json

{ "applicationId": "{{applicationId}}", "screenerId": "{{screenerId}}" }

### N23 HR: reassign (reason required)
POST {{baseUrl}}/hr-screeners/reassign
Authorization: Bearer {{token}}
Content-Type: application/json

{ "applicationId": "{{applicationId}}", "screenerId": "{{screenerId}}", "reason": "Workload balancing" }

### N24 HR: assignment history
GET {{baseUrl}}/hr-screeners/assignment-history?applicationId={{applicationId}}
Authorization: Bearer {{token}}

### N25 HR Jobs form: assign hiring managers while editing a job
PUT {{baseUrl}}/jobs/{{jobId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "hiringManagerIds": ["{{hiringManagerId}}"] }

### N26 Candidate password reset: request code (same response for unknown emails)
POST {{baseUrl}}/candidate/auth/forgot-password
Content-Type: application/json

{ "email": "candidate@example.com" }

### N27 Candidate password reset: verify code
POST {{baseUrl}}/candidate/auth/verify-reset-otp
Content-Type: application/json

{ "email": "candidate@example.com", "otp": "123456" }

### N28 Candidate password reset: set new password
POST {{baseUrl}}/candidate/auth/reset-password
Content-Type: application/json

{ "email": "candidate@example.com", "resetToken": "PASTE_RESET_TOKEN", "newPassword": "NewPassword#9" }


