######################## L0 screener #########################

### 1. Get Application Details
# Open the candidates collection in MongoDB Compass
# and copy the _id of an existing candidate.
GET {{baseUrl}}/applications/{{applicationId}}
Authorization: Bearer {{token}}


### 2. Get Application Resume
GET {{baseUrl}}/applications/{{applicationId}}/resume
Authorization: Bearer {{token}}


### 3. Get Assigned L0 Applications
# Returns applications assigned to the logged-in L0 screener.
GET {{baseUrl}}/screenings/l0/assigned
Authorization: Bearer {{token}}


### 4. Get L0 Screening Statistics
# Returns screening statistics for the logged-in L0 screener.
GET {{baseUrl}}/screenings/l0/stats
Authorization: Bearer {{token}}


### 5. Submit L0 Screening Decision
# The application must be assigned to the logged-in L0 screener.
# Use a test candidate because this request updates screening data.
POST {{baseUrl}}/applications/{{applicationId}}/screenings/l0
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "decision": "Selected",
  "feedback": "Candidate meets the initial screening requirements."
}


### 6. Get Application Screening History
# Returns the screening record and its available history.
GET {{baseUrl}}/applications/{{applicationId}}/screenings
Authorization: Bearer {{token}}

########################## L1/L2 Interviewer APIs ###################################


### 1. Get My Assigned Interviews
GET {{baseUrl}}/interviews/my
Authorization: Bearer {{token}}


### 2. Get Interview Details
# Replace interviewId with a real Interview document _id.
GET {{baseUrl}}/interviews/{{interviewId}}
Authorization: Bearer {{token}}


### 3. Submit Interview Evaluation
# The interview must be assigned to the logged-in interviewer.
POST {{baseUrl}}/interviews/{{interviewId}}/evaluation
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "overallRating": 4,
  "strengths": "Good technical understanding.",
  "concerns": "Could improve problem-solving explanations.",
  "feedback": "Candidate demonstrates the required skills.",
  "recommendation": "Advance",
  "criteria": []
}


### 4. Update Interview Evaluation
# Use only when an evaluation has already been submitted.
PATCH {{baseUrl}}/interviews/{{interviewId}}/evaluation
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "overallRating": 5,
  "strengths": "Strong technical understanding.",
  "concerns": "",
  "feedback": "Candidate meets the technical requirements.",
  "recommendation": "Advance",
  "criteria": [],
  "correctionReason": "Corrected the overall rating after reviewing the notes."
}


### 5. Get Interviews for an Application
# Use the existing Candidate MongoDB _id.
GET {{baseUrl}}/applications/{{applicationId}}/interviews
Authorization: Bearer {{token}}


### 6. Get Evaluation Form for a Stage
# Example: L1, L2, L3, L4, or another configured stage.
GET {{baseUrl}}/evaluation-forms/{{stageCode}}
Authorization: Bearer {{token}}


